{
  "name": "stock-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=12.0.1 <13"
  },
  "volta": {
    "node": "24.18.0",
    "npm": "12.0.1"
  },
  "allowScripts": {
    "fsevents": false,
    "unrs-resolver": false
  },
  "scripts": {
    "doctor": "node scripts/dev-environment.mjs",
    "setup:worktree": "node scripts/dev-environment.mjs --setup",
    "predev": "npm run doctor",
    "dev": "next dev",
    "prebuild": "npm run doctor",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript openapi/openapi.yaml -o lib/generated/schema.ts",
    "check:api": "openapi-typescript openapi/openapi.yaml -o lib/generated/schema.ts --check",
    "sync:api": "./scripts/sync-openapi.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run doctor && npm run check:api && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "^1.7.2",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.34.0",
    "next": "^16.3.2",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    },
    "js-yaml": "^4.3.1",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}

{
  "name": "stock-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "volta": {
    "node": "24.20.0",
    "npm": "12.0.2"
  },
  "allowScripts": {
    "fsevents": false,
    "unrs-resolver": false
  },
  "scripts": {
    "doctor": "node scripts/dev-environment.mjs",
    "setup:worktree": "node scripts/dev-environment.mjs --setup",
    "predev": "npm run doctor",
    "dev": "vite",
    "prebuild": "npm run doctor",
    "build": "vite build",
    "start": "vite preview",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript openapi/openapi.yaml -o lib/generated/schema.ts",
    "check:api": "openapi-typescript openapi/openapi.yaml -o lib/generated/schema.ts --check",
    "sync:api": "./scripts/sync-openapi.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run doctor && npm run check:api && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.51.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/config": "^0.9.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
